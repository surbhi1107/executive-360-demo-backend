# Copy this file to backend/.env and edit. Every setting is optional.

# Turns the "Ask" assistant on. Leave empty to run everything else without it.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MAX_TOKENS=1500

# Port for the API (and the built React app). Default 4000.
# PORT=4000

# Freeze "today" so the sample data (written for 14 Nov 2026) shows as designed. Empty = real today.
E360_AS_OF=2026-11-14

# Web address of the React app when it is hosted separately, e.g. https://executive-360-demo-frontend.vercel.app
# Empty = any address may call the API.
# E360_CORS_ORIGIN=

# Name used in the email drafts.
# E360_CEO_NAME=Anita Rao

# Simple login for a pilot: set both to ask for a username and password (HTTP Basic).
# E360_USER=
# E360_PASSWORD=

# Where the data lives (defaults are inside backend/data).
# E360_DATA_DIR=
# E360_WORKBOOK=
# E360_AGREEMENTS_DIR=
# E360_RULES=
# E360_DB=

# Flag thresholds and caching.
# E360_STALE_DAYS=3
# E360_SLIP_WEEKS=2
# E360_BUDGET_GAP=10
# E360_CACHE_SECONDS=300

# Email: off (record only), test (send everything to E360_TEST_INBOX) or live.
# E360_MAIL_MODE=off
# E360_TEST_INBOX=
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
# Follow-up and confirmation settings.
# E360_BUFFER_WEEKS=2
# E360_CONFIRM_DAYS=7
# E360_CONFIRM_GAP=10
# How often (minutes) to look for email replies and save them. 0 = only when you click the button.
# E360_REPLY_CHECK_MINUTES=2
